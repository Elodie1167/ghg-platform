# =============================================================
# GHG 碳盤查平台 — 環境變數範本
# 複製此檔為 .env 並填入實際值（.env 不進版本控制）
# =============================================================

# ─── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql://ghg_dev:ghg_dev_password@localhost:5432/ghg_platform
# Python FastAPI asyncpg 格式
ASYNC_DATABASE_URL=postgresql+asyncpg://ghg_dev:ghg_dev_password@localhost:5432/ghg_platform

# ─── Next.js Auth ─────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-please-change-in-production

# Azure AD SSO（上線後填入，本地開發可留空）
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# ─── Azure Blob Storage ───────────────────────────────────────
# 本地開發可留空（附件功能 fallback 到本地）
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=ghg-attachments

# ─── 服務間通訊 ───────────────────────────────────────────────
# Next.js 呼叫 Python agents 的 base URL
# 本地：http://localhost:8000
# Docker Compose 內：http://agents:8000
AGENTS_BASE_URL=http://localhost:8000

# ─── 環境標識 ─────────────────────────────────────────────────
ENVIRONMENT=development   # development / production
